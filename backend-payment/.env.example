PORT=3001

# Option 1: use a single hosted database URL from Railway or similar
DATABASE_URL=mysql://user:password@host:port/database

# Option 2: use split connection settings instead of DATABASE_URL
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=your_database

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# =====================
# SMS provider (Notify.lk)
# =====================
# Set SMS_ENABLED=false to skip sending.
# Set SMS_MODE=mock to simulate sending (no network call).
SMS_ENABLED=true
SMS_MODE=real

NOTIFYLK_USER_ID=replace_with_notifylk_user_id
NOTIFYLK_API_KEY=replace_with_notifylk_api_key
NOTIFYLK_SENDER_ID=replace_with_notifylk_sender_id

